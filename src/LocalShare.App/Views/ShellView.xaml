<Window x:Class="LocalShare.App.Views.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:LocalShare.App.ViewModels"
        xmlns:views="clr-namespace:LocalShare.App.Views"
        xmlns:behaviors="clr-namespace:LocalShare.App.Behaviors"
        Title="LocalShare - Ultra P2P LAN Sharing &amp; Messenger"
        Icon="pack://application:,,,/Assets/logo.png"
        Height="780" Width="1200" MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource StudioAppBrush}"
        behaviors:AdaptiveLayoutBehavior.CompactWidthThreshold="880">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <DataTemplate DataType="{x:Type vm:PeersViewModel}">
            <views:PeersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
            <views:ChatView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PublicSpaceViewModel}">
            <views:PublicSpaceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GroupsViewModel}">
            <views:GroupsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TransfersViewModel}">
            <views:TransfersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileSettingsViewModel}">
            <views:ProfileSettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" x:Name="NavColumn"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!-- SIDEBAR NAVIGATION RAIL                    -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Background="{StaticResource StudioAppBrush}"
                BorderBrush="{StaticResource StudioBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18">
                <!-- ─── App Header & User Badge ─── -->
                <StackPanel DockPanel.Dock="Top" Margin="4,8,4,28">
                    <!-- Brand Header -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Logo with ambient accent glow -->
                        <Border Width="44" Height="44" CornerRadius="12" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Color="#7C5CFC" Direction="0" ShadowDepth="0" Opacity="0.25"/>
                            </Border.Effect>
                            <Image Source="pack://application:,,,/Assets/logo.png" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="LocalShare " FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <!-- Version pill badge -->
                                <Border Background="{StaticResource StudioAccentSoftBrush}" CornerRadius="6" Padding="6,2" VerticalAlignment="Center" Margin="2,0,0,0" BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding AppVersion}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextAccent}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="P2P LAN Network" FontSize="11" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- User Status Pill -->
                    <Border CornerRadius="12" Padding="12,10" BorderThickness="1" Background="{StaticResource StudioPanelBrush}" BorderBrush="{StaticResource StudioBorderBrush}">
                        <StackPanel Orientation="Horizontal">
                            <!-- Pulsing Online Indicator -->
                            <Grid Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Ellipse Width="12" Height="12" Fill="{StaticResource SuccessColor}"/>
                                <Ellipse Width="12" Height="12" Opacity="0.4" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#10B981" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="2.2" Duration="0:0:1.8">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="2.2" Duration="0:0:1.8">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.5" To="0" Duration="0:0:1.8"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Online &amp; Broadcasting" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ─── Settings (Bottom-Docked) ─── -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <!-- Separator -->
                    <Border Height="1" Background="{StaticResource StudioBorderBrush}" Margin="8,0,8,10" Opacity="0.6"/>
                    <RadioButton Content="⚙  Settings &amp; Profile" Command="{Binding NavigateCommand}" CommandParameter="Profile" Style="{StaticResource NavRadioButtonStyle}"/>
                </StackPanel>

                <!-- ─── Navigation Links ─── -->
                <StackPanel Margin="0,4,0,0">
                    <TextBlock Text="N A V I G A T I O N" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="8,0,0,14"/>
                    <RadioButton Content="🌐  Discovered Peers" Command="{Binding NavigateCommand}" CommandParameter="Peers" IsChecked="True" Style="{StaticResource NavRadioButtonStyle}"/>
                    <RadioButton Content="💬  Instant Messenger" Command="{Binding NavigateCommand}" CommandParameter="Chat" Style="{StaticResource NavRadioButtonStyle}"/>
                    <RadioButton Content="📁  Public Space" Command="{Binding NavigateCommand}" CommandParameter="PublicSpace" Style="{StaticResource NavRadioButtonStyle}"/>
                    <!-- <RadioButton Content="👥  LAN Groups" Command="{Binding NavigateCommand}" CommandParameter="Groups" Style="{StaticResource NavRadioButtonStyle}"/> -->
                    <RadioButton Content="⚡  Transfers &amp; Logs" Command="{Binding NavigateCommand}" CommandParameter="Transfers" Style="{StaticResource NavRadioButtonStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!-- MAIN WORKSPACE AREA (Studio Workspace)     -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Column="1" Background="{StaticResource StudioWorkspaceBrush}">
            <ContentControl Content="{Binding CurrentViewModel}">
                <ContentControl.RenderTransform>
                    <TranslateTransform/>
                </ContentControl.RenderTransform>
                <ContentControl.Triggers>
                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </ContentControl.Triggers>
            </ContentControl>
        </Border>
    </Grid>
</Window>
