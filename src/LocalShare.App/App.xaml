<Application x:Class="LocalShare.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:LocalShare.App.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/Wpf.Ui.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ══════════════════════════════════════════════ -->
            <!-- DESIGN SYSTEM: STUDIO THEME PALETTE            -->
            <!-- ══════════════════════════════════════════════ -->

            <!-- Core Studio Tokens -->
            <Color x:Key="StudioAppColor">#111214</Color>
            <Color x:Key="StudioWorkspaceColor">#151618</Color>
            <Color x:Key="StudioPanelColor">#1B1D20</Color>
            <Color x:Key="StudioElevatedColor">#22252A</Color>
            <Color x:Key="StudioBorderColor">#2B2E33</Color>
            <Color x:Key="StudioAccentColor">#7C5CFC</Color>
            <Color x:Key="StudioAccentHoverColor">#8B70FF</Color>
            <Color x:Key="StudioAccentSoftColor">#1F7C5CFC</Color>

            <SolidColorBrush x:Key="StudioAppBrush" Color="#111214"/>
            <SolidColorBrush x:Key="StudioWorkspaceBrush" Color="#151618"/>
            <SolidColorBrush x:Key="StudioPanelBrush" Color="#1B1D20"/>
            <SolidColorBrush x:Key="StudioElevatedBrush" Color="#22252A"/>
            <SolidColorBrush x:Key="StudioBorderBrush" Color="#2B2E33"/>
            <SolidColorBrush x:Key="StudioAccentBrush" Color="#7C5CFC"/>
            <SolidColorBrush x:Key="StudioAccentHoverBrush" Color="#8B70FF"/>
            <SolidColorBrush x:Key="StudioAccentSoftBrush" Color="#1F7C5CFC"/>

            <!-- Semantic & Layered Surface Brushes -->
            <SolidColorBrush x:Key="AppBackground" Color="#111214"/>
            <SolidColorBrush x:Key="SidebarBackground" Color="#111214"/>
            <SolidColorBrush x:Key="CardBackground" Color="#1B1D20"/>
            <SolidColorBrush x:Key="CardHoverBackground" Color="#22252A"/>
            <SolidColorBrush x:Key="SelectedCardBackground" Color="#22252A"/>

            <SolidColorBrush x:Key="SurfaceLevel1" Color="#151618"/>
            <SolidColorBrush x:Key="SurfaceLevel2" Color="#1B1D20"/>
            <SolidColorBrush x:Key="SurfaceLevel3" Color="#22252A"/>

            <!-- Borders -->
            <SolidColorBrush x:Key="BorderBrushColor" Color="#2B2E33"/>
            <SolidColorBrush x:Key="BorderSubtle" Color="#2B2E33"/>
            <SolidColorBrush x:Key="BorderGlow" Color="#7C5CFC"/>

            <!-- Accent & Glow -->
            <SolidColorBrush x:Key="AccentGlow" Color="#7C5CFC"/>
            <SolidColorBrush x:Key="AccentGlowSubtle" Color="#6D48E5"/>
            <SolidColorBrush x:Key="AccentCyan" Color="#8B70FF"/>

            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
            <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>
            <SolidColorBrush x:Key="TextAccent" Color="#A78BFA"/>

            <!-- Semantic -->
            <SolidColorBrush x:Key="SuccessColor" Color="#10B981"/>
            <SolidColorBrush x:Key="SuccessSubtle" Color="#064E3B"/>
            <SolidColorBrush x:Key="DangerColor" Color="#EF4444"/>
            <SolidColorBrush x:Key="DangerSubtle" Color="#451A1A"/>
            <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>

            <!-- ═══════════════════ -->
            <!--     GRADIENTS      -->
            <!-- ═══════════════════ -->

            <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#7C5CFC" Offset="0.0"/>
                <GradientStop Color="#8B70FF" Offset="1.0"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#059669" Offset="0.0"/>
                <GradientStop Color="#10B981" Offset="1.0"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#DC2626" Offset="0.0"/>
                <GradientStop Color="#EF4444" Offset="1.0"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="SendNowGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#6D48E5" Offset="0.0"/>
                <GradientStop Color="#7C5CFC" Offset="0.5"/>
                <GradientStop Color="#8B70FF" Offset="1.0"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#111214" Offset="0.0"/>
                <GradientStop Color="#151618" Offset="1.0"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="GlassBorderGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2B2E33" Offset="0.0"/>
                <GradientStop Color="#1B1D20" Offset="0.5"/>
                <GradientStop Color="#2B2E33" Offset="1.0"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="TitleGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FFFFFF" Offset="0.0"/>
                <GradientStop Color="#E9D5FF" Offset="0.5"/>
                <GradientStop Color="#A78BFA" Offset="1.0"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="AccentBorderGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#7C5CFC" Offset="0.0"/>
                <GradientStop Color="#8B70FF" Offset="1.0"/>
            </LinearGradientBrush>

            <!-- ═══════════════════════════════════ -->
            <!--     CONVERTERS                     -->
            <!-- ═══════════════════════════════════ -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <helpers:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <helpers:FileSizeConverter x:Key="FileSizeConverter"/>
            <helpers:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

            <!-- ═══════════════════════════════════ -->
            <!--     MODERN PRIMARY BUTTON STYLE    -->
            <!-- ═══════════════════════════════════ -->
            <Style x:Key="ModernPrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="18,9"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="borderScale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#8B70FF"/>
                                    <Setter TargetName="border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="16" Color="#7C5CFC" Direction="0" ShadowDepth="0" Opacity="0.45"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════════════════════════ -->
            <!--     MODERN SUCCESS BUTTON STYLE    -->
            <!-- ═══════════════════════════════════ -->
            <Style x:Key="ModernSuccessButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource SuccessGradient}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#34D399"/>
                                    <Setter TargetName="border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="14" Color="#10B981" Direction="0" ShadowDepth="0" Opacity="0.35"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════════════════════════ -->
            <!--     MODERN DANGER BUTTON STYLE     -->
            <!-- ═══════════════════════════════════ -->
            <Style x:Key="ModernDangerButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource DangerGradient}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FCA5A5"/>
                                    <Setter TargetName="border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="14" Color="#EF4444" Direction="0" ShadowDepth="0" Opacity="0.35"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════════════════════════ -->
            <!--     GHOST / SUBTLE BUTTON STYLE    -->
            <!-- ═══════════════════════════════════ -->
            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="Background" Value="#22252A"/>
                <Setter Property="Foreground" Value="#9CA3AF"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="#2B2E33">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#2B2E33"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#7C5CFC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════════════════════════ -->
            <!--     GLASS CARD / PANEL CARD STYLE  -->
            <!-- ═══════════════════════════════════ -->
            <Style x:Key="GlassCard" TargetType="Border">
                <Setter Property="Background" Value="#1B1D20"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#2B2E33"/>
                <Setter Property="Padding" Value="18"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="12" Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.25"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#7C5CFC"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="20" Color="#7C5CFC" Direction="0" ShadowDepth="0" Opacity="0.15"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ═══════════════════════════════════════ -->
            <!--     HIGH VISIBILITY CHECKBOX STYLE     -->
            <!-- ═══════════════════════════════════════ -->
            <Style x:Key="HighVisibilityCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="box" Width="24" Height="24" CornerRadius="7" Background="#151618" BorderBrush="#2B2E33" BorderThickness="2" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock x:Name="checkMark" Text="✓" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                                    </Grid>
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="box" Property="Background" Value="#7C5CFC"/>
                                    <Setter TargetName="box" Property="BorderBrush" Value="#8B70FF"/>
                                    <Setter TargetName="checkMark" Property="Opacity" Value="1"/>
                                    <Setter TargetName="box" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="8" Color="#7C5CFC" Direction="0" ShadowDepth="0" Opacity="0.35"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="box" Property="BorderBrush" Value="#8B70FF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════════════════════════ -->
            <!--     DARK COMBOBOX ITEM STYLE       -->
            <!-- ═══════════════════════════════════ -->
            <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
                <Setter Property="Background" Value="#1B1D20"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8" Margin="2,1">
                                <Grid>
                                    <Rectangle x:Name="accentBar" Width="3" Fill="#7C5CFC" HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5" Opacity="0" Margin="-6,4,-2,4"/>
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#22252A"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#22252A"/>
                                    <Setter Property="Foreground" Value="#A78BFA"/>
                                    <Setter TargetName="accentBar" Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItemStyle}"/>

            <!-- ═══════════════════════════════════════ -->
            <!--     SIDEBAR NAV RADIO BUTTON STYLE     -->
            <!-- ═══════════════════════════════════════ -->
            <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="#9CA3AF"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Height" Value="46"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="14,0">
                                <Grid>
                                    <!-- Accent indicator bar (left edge) -->
                                    <Rectangle x:Name="indicator" Width="3" Height="22" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left" Margin="-8,0,0,0" Opacity="0">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#7C5CFC" Offset="0"/>
                                                <GradientStop Color="#8B70FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1B1D20"/>
                                    <Setter Property="Foreground" Value="#F3F4F6"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#22252A"/>
                                    <Setter Property="Foreground" Value="#A78BFA"/>
                                    <Setter TargetName="indicator" Property="Opacity" Value="1"/>
                                    <Setter TargetName="bd" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="12" Color="#7C5CFC" Direction="0" ShadowDepth="0" Opacity="0.12"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════════════════════════ -->
            <!--     MODERN TEXT INPUT STYLE        -->
            <!-- ═══════════════════════════════════ -->
            <Style x:Key="ModernTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="#151618"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#2B2E33"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="CaretBrush" Value="#A78BFA"/>
                <Setter Property="SelectionBrush" Value="#7C5CFC"/>
                <Style.Triggers>
                    <Trigger Property="IsFocused" Value="True">
                        <Setter Property="BorderBrush" Value="#7C5CFC"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#8B70FF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ═══════════════════════════════════════════ -->
            <!--     ANIMATED PROGRESS BAR WITH SHIMMER     -->
            <!-- ═══════════════════════════════════════════ -->
            <Style x:Key="AnimatedProgressBar" TargetType="ProgressBar">
                <Setter Property="Height" Value="6"/>
                <Setter Property="Background" Value="#22252A"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                <Grid>
                                    <Border x:Name="PART_Track" CornerRadius="3"/>
                                    <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#6D48E5" Offset="0"/>
                                                <GradientStop Color="#7C5CFC" Offset="0.5"/>
                                                <GradientStop Color="#8B70FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <!-- Shimmer overlay -->
                                        <Border CornerRadius="3" Opacity="0.3">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" SpreadMethod="Reflect">
                                                    <LinearGradientBrush.Transform>
                                                        <TranslateTransform x:Name="ShimmerTransform" X="0"/>
                                                    </LinearGradientBrush.Transform>
                                                    <GradientStop Color="Transparent" Offset="0"/>
                                                    <GradientStop Color="#FFFFFF" Offset="0.5"/>
                                                    <GradientStop Color="Transparent" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════════════════════════════════ -->
            <!--     PULSING ONLINE INDICATOR               -->
            <!-- ═══════════════════════════════════════════ -->
            <Style x:Key="PulsingOnlineIndicator" TargetType="Grid">
                <Setter Property="Width" Value="12"/>
                <Setter Property="Height" Value="12"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
