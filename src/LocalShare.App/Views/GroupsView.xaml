<UserControl x:Class="LocalShare.App.Views.GroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="28,24,28,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════ -->
        <!-- GROUPS ROSTER (Left Panel)         -->
        <!-- ═══════════════════════════════════ -->
        <Border CornerRadius="14"
                Padding="20"
                Margin="0,0,14,0"
                BorderThickness="1"
                Background="{StaticResource StudioPanelBrush}"
                BorderBrush="{StaticResource StudioBorderBrush}">
            <DockPanel>
                <!-- Header -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                    <TextBlock Text="Groups"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource TitleGradient}"/>
                    <TextBlock Text="Manage your device groups"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Create Group Input -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" 
                             Background="{StaticResource StudioWorkspaceBrush}"
                             Foreground="White"
                             BorderBrush="{StaticResource StudioBorderBrush}"
                             BorderThickness="1"
                             Padding="12,10"
                             FontSize="13"
                             CaretBrush="{StaticResource TextAccent}"
                             SelectionBrush="{StaticResource AccentGlow}"
                             Margin="0,0,8,0"/>
                    <Button Grid.Column="1"
                            Content="+ Create"
                            Command="{Binding CreateGroupCommand}"
                            Style="{StaticResource ModernPrimaryButton}"
                            FontSize="12"
                            Padding="14,8"/>
                </Grid>

                <!-- Groups List -->
                <ListBox ItemsSource="{Binding Groups}"
                         SelectedItem="{Binding SelectedGroup}" 
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="cardBd"
                                                Background="{StaticResource StudioElevatedBrush}"
                                                CornerRadius="10"
                                                Padding="14,12"
                                                BorderThickness="1"
                                                BorderBrush="{StaticResource StudioBorderBrush}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="cardBd" Property="Background" Value="{StaticResource StudioBorderBrush}"/>
                                                <Setter TargetName="cardBd" Property="BorderBrush" Value="{StaticResource StudioAccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="cardBd" Property="Background" Value="{StaticResource StudioBorderBrush}"/>
                                                <Setter TargetName="cardBd" Property="BorderBrush" Value="{StaticResource StudioAccentBrush}"/>
                                                <Setter TargetName="cardBd" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="14"
                                                                          Color="#7C5CFC"
                                                                          Direction="0"
                                                                          ShadowDepth="0"
                                                                          Opacity="0.2"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Group Icon -->
                                <Border Width="36"
                                        Height="36"
                                        CornerRadius="18"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource PrimaryGradient}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" Color="#7C5CFC" Direction="0" ShadowDepth="0" Opacity="0.25"/>
                                    </Border.Effect>
                                    <TextBlock Text="👥" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Member count badge -->
                                <Border Grid.Column="2"
                                        CornerRadius="10"
                                        Padding="8,4"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource StudioAccentSoftBrush}"
                                        BorderBrush="{StaticResource StudioBorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding Members.Count, StringFormat='{}{0} Members'}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextAccent}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════ -->
        <!-- SELECTED GROUP DETAILS (Right)     -->
        <!-- ═══════════════════════════════════ -->
        <Border Grid.Column="1"
                CornerRadius="14"
                Padding="24"
                BorderThickness="1"
                Background="{StaticResource StudioPanelBrush}"
                BorderBrush="{StaticResource StudioBorderBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Group Name Header -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource TitleGradient}">
                        <TextBlock.Text>
                            <Binding Path="SelectedGroup.Name" FallbackValue="Select or Create a Group"/>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="Group Details &amp; Members"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Members List -->
                <DockPanel Grid.Row="1">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                        <TextBlock Text="👥" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Group Members"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                    
                    <ListBox ItemsSource="{Binding SelectedGroup.Members}" 
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="memBd"
                                                    Background="{StaticResource StudioElevatedBrush}"
                                                    CornerRadius="10"
                                                    Padding="12,10"
                                                    BorderThickness="1"
                                                    BorderBrush="{StaticResource StudioBorderBrush}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="memBd" Property="Background" Value="{StaticResource StudioBorderBrush}"/>
                                                    <Setter TargetName="memBd" Property="BorderBrush" Value="{StaticResource StudioAccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Avatar Circle -->
                                    <Border Width="36"
                                            Height="36"
                                            CornerRadius="18"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource PrimaryGradient}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" Color="#7C5CFC" Direction="0" ShadowDepth="0" Opacity="0.25"/>
                                        </Border.Effect>
                                        <TextBlock Text="👤" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Add Member Panel -->
                <Border Grid.Row="2"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,18,0,0"
                        BorderThickness="1"
                        Background="{StaticResource StudioElevatedBrush}"
                        BorderBrush="{StaticResource StudioBorderBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="➕" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Add LAN Peer"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailablePeers}"
                                  DisplayMemberPath="DisplayName"
                                  x:Name="PeerCombo" 
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  Background="{StaticResource StudioWorkspaceBrush}"
                                  Foreground="White"
                                  BorderBrush="{StaticResource StudioBorderBrush}"/>

                        <Button Grid.Column="2"
                                Content="Add to Group" 
                                Command="{Binding AddMemberToGroupCommand}" 
                                CommandParameter="{Binding SelectedItem, ElementName=PeerCombo}" 
                                Style="{StaticResource ModernPrimaryButton}"
                                FontSize="12"
                                Padding="14,8"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
