<UserControl x:Class="LocalShare.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             AllowDrop="True"
             Drop="ChatView_Drop"
             DragOver="ChatView_DragOver">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Conversations Sidebar -->
        <Border Background="{StaticResource StudioPanelBrush}" CornerRadius="16" Margin="0,0,20,0" BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="Conversations" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" DockPanel.Dock="Top" Margin="20,20,20,16"/>
                
                <ListBox ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation}" Background="Transparent" BorderThickness="0" Padding="12,0,12,12" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="{StaticResource StudioElevatedBrush}" CornerRadius="12" BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="1" Padding="14,12">
                                            <Grid>
                                                <Rectangle x:Name="accentBar" Width="3" HorizontalAlignment="Left" Margin="-14,-12,0,-12" Fill="{StaticResource StudioAccentBrush}" Opacity="0" RadiusX="1.5" RadiusY="1.5"/>
                                                <ContentPresenter/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource StudioBorderBrush}"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource StudioAccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource StudioBorderBrush}"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource StudioAccentBrush}"/>
                                                <Setter TargetName="accentBar" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding LastMessageAt, StringFormat='{}{0:g}'}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Main Chat & Messages Panel -->
        <Border Grid.Column="1" Background="{StaticResource StudioWorkspaceBrush}" CornerRadius="16" BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Background="{StaticResource StudioPanelBrush}" Padding="20,16" CornerRadius="16,16,0,0" BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource PrimaryGradient}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#7C5CFC" Direction="0" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <ui:SymbolIcon Symbol="Person24" Foreground="White" FontSize="22"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="{Binding SelectedConversation.DisplayName, FallbackValue='Select a conversation to start chatting'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            
                            <!-- Typing Indicator -->
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding TypingText}" FontSize="12" Foreground="{StaticResource TextAccent}" FontWeight="SemiBold"/>
                                <Grid Style="{StaticResource PulsingOnlineIndicator}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding TypingText, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                                    <Ellipse Fill="{StaticResource StudioAccentBrush}">
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.8" AutoReverse="True"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Messages Stream -->
                <ScrollViewer Grid.Row="1" Margin="20" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Grid.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="15" To="0" Duration="0:0:0.3">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Grid.Triggers>
                                    <Grid.RenderTransform>
                                        <TranslateTransform Y="0"/>
                                    </Grid.RenderTransform>

                                    <!-- Bubble -->
                                    <Border x:Name="MessageBubble" Padding="16,12" Background="{StaticResource StudioPanelBrush}" CornerRadius="12,12,12,4" HorizontalAlignment="Left" MaxWidth="560" BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock x:Name="SenderText" Text="{Binding SenderDisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextAccent}" Margin="0,0,0,4"/>
                                            
                                            <TextBlock x:Name="BodyText" Text="{Binding Body}" FontSize="14" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Visibility="{Binding Body, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            
                                            <!-- Attachment Badge with Open Action -->
                                            <Border Visibility="{Binding AttachmentFileName, Converter={StaticResource StringToVisibilityConverter}}" 
                                                    Background="{StaticResource StudioElevatedBrush}" 
                                                    CornerRadius="10" 
                                                    Padding="12,10" 
                                                    Margin="0,8,0,0" 
                                                    BorderBrush="{StaticResource StudioBorderBrush}" 
                                                    BorderThickness="1"
                                                    Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick" 
                                                                  Command="{Binding DataContext.OpenFileAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource StudioPanelBrush}" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <ui:SymbolIcon Symbol="Document24" Foreground="{StaticResource TextAccent}" FontSize="18"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AttachmentFileName}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding AttachmentSizeBytes, Converter={StaticResource FileSizeConverter}}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" 
                                                            ToolTip="Open File" 
                                                            Command="{Binding DataContext.OpenFileAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}" 
                                                            Style="{StaticResource GhostButton}" 
                                                            Padding="8,6" 
                                                            Margin="10,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Open24" FontSize="14"/>
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <TextBlock x:Name="TimeText" Text="{Binding SentAt, StringFormat='{}{0:t}'}" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <!-- Fallback styling for own messages based on SenderDisplayName -->
                                    <DataTrigger Binding="{Binding SenderDisplayName}" Value="Me">
                                        <Setter TargetName="MessageBubble" Property="Background" Value="{StaticResource PrimaryGradient}"/>
                                        <Setter TargetName="MessageBubble" Property="CornerRadius" Value="12,12,4,12"/>
                                        <Setter TargetName="MessageBubble" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="MessageBubble" Property="BorderThickness" Value="0"/>
                                        <Setter TargetName="SenderText" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="TimeText" Property="Foreground" Value="#E9D5FF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSentByMe}" Value="True">
                                        <Setter TargetName="MessageBubble" Property="Background" Value="{StaticResource PrimaryGradient}"/>
                                        <Setter TargetName="MessageBubble" Property="CornerRadius" Value="12,12,4,12"/>
                                        <Setter TargetName="MessageBubble" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="MessageBubble" Property="BorderThickness" Value="0"/>
                                        <Setter TargetName="SenderText" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="TimeText" Property="Foreground" Value="#E9D5FF"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Attachment Active Pill Bar -->
                <Border Grid.Row="2" Background="{StaticResource StudioPanelBrush}" Margin="20,0,20,8" Padding="14,10" CornerRadius="10" BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="1" Visibility="{Binding SelectedAttachmentPath, Converter={StaticResource StringToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Attach24" Foreground="{StaticResource TextAccent}" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedAttachmentPath}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="2" Content="Remove" Command="{Binding ClearAttachmentCommand}" Style="{StaticResource GhostButton}" Foreground="{StaticResource DangerColor}" Padding="12,6"/>
                    </Grid>
                </Border>

                <!-- Message Input & Send Control -->
                <StackPanel Grid.Row="3" Margin="20,0,20,20">
                    <Border Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{StaticResource DangerSubtle}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" BorderBrush="{StaticResource DangerColor}" BorderThickness="1">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerColor}" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center"/>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Command="{Binding SelectAttachmentCommand}" Style="{StaticResource GhostButton}" Margin="0,0,12,0" Padding="14,12" ToolTip="Attach File">
                            <ui:SymbolIcon Symbol="Attach24" FontSize="20"/>
                        </Button>

                        <Border Grid.Column="1" Background="{StaticResource StudioPanelBrush}" CornerRadius="12" BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="1">
                            <TextBox Text="{Binding MessageInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Background="Transparent" BorderThickness="0" Padding="16,14" FontSize="14" VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SendMessageCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </Border>

                        <Button Grid.Column="2" Command="{Binding SendMessageCommand}" IsEnabled="{Binding IsSending, Converter={StaticResource InverseBooleanConverter}}" Style="{StaticResource ModernPrimaryButton}" Margin="12,0,0,0" Padding="20,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Send" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                                <ui:SymbolIcon Symbol="Send24" FontSize="18" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
