<UserControl x:Class="LocalShare.App.Views.TransfersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,24">
            <TextBlock Text="File Transfers Log" FontSize="26" FontWeight="Bold" VerticalAlignment="Center">
                <TextBlock.Foreground>
                    <StaticResource ResourceKey="TitleGradient"/>
                </TextBlock.Foreground>
            </TextBlock>

            <Button Content="🗑️  Clear All Records"
                    Command="{Binding ClearAllTransfersCommand}"
                    Style="{StaticResource ModernDangerButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Padding="14,8"/>
        </Grid>

        <!-- Empty State -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=TransfersList, Path=HasItems}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <ui:SymbolIcon Symbol="History24" FontSize="48" Foreground="{StaticResource TextMuted}" Margin="0,0,0,16"/>
            <TextBlock Text="No active transfers" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Files you send or receive will appear here." FontSize="14" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Transfers List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="TransfersList" ItemsSource="{Binding Transfers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GlassCard}" Margin="0,0,0,12">
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" />
                                            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,20,0,-8" To="0,0,0,12" Duration="0:0:0.4">
                                                <ThicknessAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </ThicknessAnimation.EasingFunction>
                                            </ThicknessAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Direction Badge -->
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="{StaticResource SurfaceLevel2}" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon FontSize="22">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="ArrowDownload24"/>
                                                <Setter Property="Foreground" Value="{StaticResource SuccessColor}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Direction}" Value="Upload">
                                                        <Setter Property="Symbol" Value="ArrowUpload24"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentGlow}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                </Border>

                                <!-- File Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SizeBytes}" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>

                                <!-- Progress Section -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource AccentGlow}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Status}" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0:F1}%}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextAccent}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}" Maximum="100" Style="{StaticResource AnimatedProgressBar}"/>
                                </StackPanel>

                                <!-- Peer Badge -->
                                <Border Grid.Column="3" Background="{StaticResource SurfaceLevel3}" CornerRadius="12" Padding="12,6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Person24" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding PeerDisplayName}" FontSize="13" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="100"/>
                                    </StackPanel>
                                </Border>

                                <!-- Actions -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Pause" 
                                            Command="{Binding DataContext.PauseTransferCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" 
                                            Style="{StaticResource GhostButton}" 
                                            Margin="0,0,8,0"/>
                                    <Button Content="Resume" 
                                            Command="{Binding DataContext.ResumeTransferCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" 
                                            Style="{StaticResource ModernPrimaryButton}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
