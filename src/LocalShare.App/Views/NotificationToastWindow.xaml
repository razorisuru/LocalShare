<Window x:Class="LocalShare.App.Views.NotificationToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="File Received Notification"
        Height="115" Width="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <Storyboard x:Key="SlideInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                             From="0.0" To="1.0" 
                             Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" 
                             From="160" To="0" 
                             Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="7"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.RenderTransform>
        <TranslateTransform/>
    </Window.RenderTransform>

    <Border CornerRadius="14" 
            Padding="0" 
            Cursor="Hand" 
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#1B1D20"/>
                <Setter Property="BorderBrush" Value="#2B2E33"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#22252A"/>
                        <Setter Property="BorderBrush" Value="#7C5CFC"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Color="#000000" Direction="270" Opacity="0.75" ShadowDepth="6"/>
        </Border.Effect>
        <Grid>
            <!-- Accent Left Edge Bar -->
            <Border Width="3.5" HorizontalAlignment="Left" VerticalAlignment="Stretch" CornerRadius="13,0,0,13">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#7C5CFC" Offset="0.0"/>
                        <GradientStop Color="#8B70FF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Main Content Container -->
            <Grid Margin="16,14,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Container -->
                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Margin="0,0,14,0" VerticalAlignment="Center" Background="#22252A" BorderBrush="#2B2E33" BorderThickness="1">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="22" Foreground="#A78BFA"/>
                    </Grid>
                </Border>

                <!-- Text Content -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtTitle" 
                               Text="File Received" 
                               Foreground="#A78BFA" 
                               FontSize="13.5" 
                               FontWeight="Bold" 
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtFileName" 
                               Text="filename.ext" 
                               Foreground="#FFFFFF" 
                               FontSize="12.5" 
                               FontWeight="Bold" 
                               Margin="0,3,0,3" 
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Click to view file in folder" 
                               Foreground="#9CA3AF" 
                               FontSize="11" 
                               FontWeight="Medium"/>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2" 
                        Click="CloseButton_Click" 
                        Cursor="Hand" 
                        VerticalAlignment="Top" 
                        Margin="0,-2,0,0"
                        Width="26" Height="26"
                        ToolTip="Dismiss">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" 
                                    Background="Transparent" 
                                    CornerRadius="8" 
                                    BorderThickness="1" 
                                    BorderBrush="Transparent">
                                <ui:SymbolIcon x:Name="dismissIcon" 
                                               Symbol="Dismiss24" 
                                               FontSize="14" 
                                               Foreground="#9CA3AF" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#2B2E33"/>
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#7C5CFC"/>
                                    <Setter TargetName="dismissIcon" Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#151618"/>
                                    <Setter TargetName="dismissIcon" Property="Foreground" Value="#A78BFA"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
